# Copy to .env (never commit .env). After changing it press r; if the old value sticks, run `npx expo start -c`.
# Local backend: your laptop's LAN IP (ipconfig on Windows), or http://localhost:3000 over USB with adb reverse; start the
# backend with HOST=0.0.0.0 so the phone can reach it on the same Wi-Fi.
# Deployed backend (Railway): https://midtermprojectcampusportal-production.up.railway.app
EXPO_PUBLIC_API_URL=https://midtermprojectcampusportal-production.up.railway.app
