# Copy to backend/.env. Names only: never commit real values.
# Run npm commands from backend/ or use npm --prefix backend.
HOST=127.0.0.1
PORT=3000

# Development database: a local SQLite file opened through @libsql/client.
DB_PATH=./data/campus.db

# Production database (Turso). Leave both EMPTY on your laptop so you can never
# write to production by accident. On Render they are set in the dashboard.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# One exact origin, or several separated by commas (no trailing slash).
CORS_ORIGIN=http://localhost:5173

# Replace with the output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret
